# Optional overrides. Copy to .env.local only if you need them; none are required.
# No API keys are needed in Phase 1, and none should ever be committed.

# Where the database and media kit files live (default: ./data)
# OUTREACH_DATA_DIR=./data

# Ports (defaults avoid your creator dashboard on 5173)
# OUTREACH_API_PORT=5181
# OUTREACH_WEB_PORT=5180
